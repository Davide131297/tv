# Copy this file to .env and adjust if needed.
# Vars must be prefixed with EXPO_PUBLIC_ to be inlined into the app bundle
# (see https://docs.expo.dev/guides/environment-variables/).
# They end up in the client bundle, so never put secrets here.

# Base URL of the Polittalk-Watcher web app / API (no trailing slash).
# EAS builds set this in eas.json.
EXPO_PUBLIC_API_BASE_URL=https://polittalk-watcher.de
